<UserControl x:Class="task_monitor.PowerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:local="clr-namespace:task_monitor"
             Background="Transparent">

    <ikw:SimpleStackPanel Spacing="12">

        <Grid Margin="0,2,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:FontIcon FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"
                             Icon="{x:Static ui:FluentSystemIcons.Gauge_20_Regular}" />
                <TextBlock Text="功耗" FontSize="22" VerticalAlignment="Center" />
                <ContentControl x:Name="PinSlotHost" VerticalAlignment="Center"
                                Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="CoreTotalHeaderText" FontSize="22"
                           HorizontalAlignment="Right" />
                <TextBlock x:Name="CoreTotalHeaderLabelText" FontSize="9"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,-4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="CPU 封装当前功率" FontSize="10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CpuInputWattsText" Text="—" FontSize="13" />
                    <TextBlock x:Name="CpuInputStatusText" Margin="6,2,0,0" FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="GPU 当前功率合计（NVML）" FontSize="10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="GpuInputWattsText" Text="—" FontSize="13" />
                    <TextBlock x:Name="GpuInputStatusText" Margin="6,2,0,0" FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Margin="0,-2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BatteryStatusTextBlock" Grid.Column="0" FontSize="12">
                <Run Text="电池状态：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Run x:Name="BatteryStatusRun" Text="—" />
            </TextBlock>
            <TextBlock Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                <Run Text="来源：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Run x:Name="CpuSourceRun" Text="—" />
            </TextBlock>
        </Grid>

        <Border Background="Transparent" BorderThickness="0" Padding="0,4" Height="124">
            <local:PowerHistoryChart x:Name="PowerChart" Background="Transparent" />
        </Border>

        <Grid Margin="0,-8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="CpuLegendDot" Width="7" Height="7" Margin="0,0,6,0" />
                <TextBlock Text="CPU 封装" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="GpuLegendDot" Width="7" Height="7" Margin="0,0,6,0" />
                <TextBlock Text="GPU 合计" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="BatteryLegendDot" Width="7" Height="7" Margin="0,0,6,0" />
                <TextBlock x:Name="BatteryLegendText" Text="放电" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="BatteryChargeLegendDot" Width="7" Height="7" Margin="0,0,6,0" />
                <TextBlock Text="充电" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border x:Name="PowerUnavailableNotice" Background="Transparent" BorderThickness="0"
                Padding="0,18,0,4" Visibility="Collapsed">
            <TextBlock x:Name="PowerUnavailableText"
                       Text="当前没有可用的 CPU 封装功率读数"
                       FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>

        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="CPU 封装峰值功率" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="CpuPackagePeakText" Text="—" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="GPU 峰值功率" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="GpuPowerPeakText" Text="—" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="核心累计能耗" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="CoreTotalEnergyText" Text="—" FontSize="13" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,-2,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="BatteryAverageLabelText" Text="电池平均" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BatteryAverageText" Text="—" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="BatteryPeakLabelText" Text="电池峰值" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BatteryPeakText" Text="—" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="BatteryEnergyLabelText" Text="电池累计" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BatteryEnergyText" Text="—" FontSize="13" />
            </StackPanel>
        </Grid>

        <Border Background="Transparent" BorderThickness="0" Padding="0,4">
            <ikw:SimpleStackPanel Spacing="7">
                <Grid>
                    <TextBlock Text="GPU 功耗" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="读数" FontSize="12"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock Text="GPU 行目前仅读取 NVIDIA NVML；Intel RAPL 图形域如平台提供会列在下方，AMD GPU 功率尚未接入"
                           FontSize="10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="NoGpuPowerNotice" Text="未检测到 NVIDIA NVML 功耗读数"
                           FontSize="11" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="GpuPowerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Tooltip}" />
                                <TextBlock Grid.Column="1" Text="{Binding WattsText}"
                                           FontSize="12" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                           FontSize="10" Margin="8,0,0,0"
                                           ToolTip="{Binding Source}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ikw:SimpleStackPanel>
        </Border>

        <Border Background="Transparent" BorderThickness="0" Padding="0,4">
            <ikw:SimpleStackPanel Spacing="7">
                <Grid>
                    <TextBlock Text="硬件传感器功率域" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="读数" FontSize="12"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock x:Name="NoComponentsNotice" Text="未检测到组件功耗传感器"
                           FontSize="11" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="ComponentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Source}" />
                                <TextBlock Grid.Column="1" Text="{Binding WattsText}"
                                           FontSize="12" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                           FontSize="10" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ikw:SimpleStackPanel>
        </Border>

        <Popup x:Name="HistoryTip" PlacementTarget="{Binding ElementName=PowerChart}"
               Placement="Relative" StaysOpen="True" AllowsTransparency="True">
            <Border x:Name="HistoryTipBorder"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8,4">
                <TextBlock x:Name="HistoryTipText" FontSize="12"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
        </Popup>
    </ikw:SimpleStackPanel>
</UserControl>
